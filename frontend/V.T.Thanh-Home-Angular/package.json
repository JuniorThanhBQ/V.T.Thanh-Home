{
  "name": "v.t.thanh-home-angular",
  "version": "3.0.0",
  "scripts": {
    "ng": "node scripts/angular.mjs",
    "start": "node scripts/angular.mjs serve",
    "build": "node scripts/angular.mjs build",
    "postbuild": "node scripts/sentry-sourcemaps.mjs && node scripts/write-pwa-resources.mjs && ngsw-config dist/V.T.Thanh-Home-Angular/browser ngsw-config.json / && npm run check:pwa",
    "watch": "node scripts/angular.mjs build --watch --configuration development",
    "prettier": "prettier --write \"src/**/*.ts\" \"src/**/*.html\" \"src/**/*.css\"",
    "test": "ng test",
    "lint": "ng lint",
    "check:offline-assets": "node scripts/check-offline-assets.mjs",
    "prebuild": "npm run check:hosting && node scripts/generate-ngsw-config.mjs && node scripts/check-offline-assets.mjs",
    "check:pwa": "node scripts/check-offline-assets.mjs --build && node scripts/check-pwa.mjs",
    "preview:pwa": "node scripts/preview-pwa.mjs",
    "e2e:pwa": "playwright test",
    "check:hosting": "node scripts/check-hosting.mjs",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "probe:pwa": "node scripts/probe-pwa.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "22.2.3",
    "@sentry/angular": "^11.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@sentry/cli": "^3.8.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "26.6.5",
    "@types/three": "^0.186.0",
    "@vercel/routing-utils": "6.6.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@sentry/cli@3.8.2": true
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "engines": {
    "node": "24.x",
    "npm": "12.2.x"
  }
}
